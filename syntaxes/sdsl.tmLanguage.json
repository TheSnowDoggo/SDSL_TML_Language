{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SDSL",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#literals"
		},
		{
			"include": "#operators"
		},
		{	
			"include": "#keywords"
		},
		{
			"include": "#entity_names"
		},
		{
			"include": "#types"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.block.sdsl",
					"begin": "#\\*",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.sdsl"
						}
					},
					"end": "\\*#"
				},
				{
					"name": "comment.line.sdsl",
					"begin": "#",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.sdsl"
						}
					},
					"end": "\\n"
				}
			]
		},
		"literals": {
			"patterns": [
				{
					"name": "string.quoted.double.sdsl",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.sdsl",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.single.sdsl",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.sdsl",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "constant.numeric.sdsl",
					"match": "\\b-?(\\d+\\.\\d+|\\d+)"
				},
				{
					"name": "constant.language.sdsl",
					"match": "\\b(nil|true|false)"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.sdsl",
					"match": "\\b(namespace|using|class|func|new|static|var|const|constexpr|enum|not|and|or)\\b"
				},
				{
					"name": "keyword.control.sdsl",
					"match": "\\b(return|if|else|while|break|continue|for|in|switch|default|self)\\b"
				}
			]
		},
		"entity_names": {
			"patterns": [
				{
					"name": "entity.name.function.sdsl",
					"match": "[A-Za-z_]+[A-Za-z0-9_]*\\("
				}
			]
		},
		"types": {
			"patterns": [{
				"name": "entity.name.type.sdsl",
				"match": "\\b(Nil|Bool|Number|DateTime|TimeSpan|String|Function)\\b"
			}]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.comparison.sdsl",
					"match": "<|>|<=|>=|==|!="
				},
				{
					"name": "keyword.assignment.sdsl",
					"match": "\\*\\*=|\\*=|\\/=|\\/\\/=|%=|\\+=|-=|<<=|>>=|>>>=|&=|\\^=|\\|=|:=|="
				},
				{
					"name": "keyword.special.sdsl",
					"match": "->|,|\\?|\\.\\.|\\.|::|:|;"
				},
				{
					"name": "keyword.arithmetic.sdsl",
					"match": "\\*\\*|\\*|\\/|\\/\\/|%|\\+|-|<<|>>|>>>|&|\\^|\\|"
				},
				{
					"name": "keyword.conditional.sdsl",
					"match": "&&|\\|\\|"
				},
				{
					"name": "keyword.unary.sdsl",
					"match": "-|!"
				}
			]
		}
	},
	"scopeName": "source.sdsl"
}