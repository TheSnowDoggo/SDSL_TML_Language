{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SDSL",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{	
			"include": "#keywords"
		},
		{
			"include": "#entities"
		},
		{
			"include": "#literals"
		},
		{
			"include": "#operators"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.block.sdsl",
					"begin": "#\\*",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.sdsl"
						}
					},
					"end": "\\*#"
				},
				{
					"name": "comment.line.sdsl",
					"begin": "#",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.sdsl"
						}
					},
					"end": "\\n"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.sdsl",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.sdsl",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.single.sdsl",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.sdsl",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.other.sdsl",
					"match": "\\b(class|new|static|func|var|const|base)\\b"
				},
				{
					"name": "keyword.control.less.sdsl",
					"match": "\\b(return|if|else|switch|default|while|for|in|break|continue|not|and|or)\\b"
				},
				{
					"match": "\\b(class)\\s+([A-Za-z_]+\\w*)\\b",
					"captures": {
						"1": {
							"name": "keyword.other.sdsl"
						},
						"2": {
							"name": "entity.name.class.sdsl"
						}
					}
				},
				{
					"match": "\\b(new)\\s+([A-Za-z_]+\\w*)\\s*(?:\\()",
					"captures": {
						"1": {
							"name": "keyword.other.sdsl"
						},
						"2": {
							"name": "entity.name.class.sdsl"
						}
					}
				},
				{
					"name": "variable.language.sdsl",
					"match": "\\b(self.)\\b"
				}
			]
		},
		"entities": {
			"patterns": [
				{
					"name": "variable.name.sdsl",
					"match": "\\b(?:var|const|constexpr)\\s+([A-Za-z_]+\\w*)\\b"
				},
				{
					"match": "(\\:)\\s*([A-Za-z_]+\\w*)\\b",
					"captures": {
						"1": {
							"name": "keyword.special.sdsl"
						},
						"2": {
							"name": "entity.name.class.sdsl"
						}
					}
				},
				{
					"match": "\\b([A-Z]+\\w*)(\\.)",
					"captures": {
						"1": {
							"name": "entity.name.class.sdsl"
						},
						"2": {
							"name": "keyword.special.sdsl"
						}
					}
				},
				{
					"match": "(->)\\s*([A-Za-z_]+\\w*)\\b",
					"captures": {
						"1": {
							"name": "keyword.special.sdsl"
						},
						"2": {
							"name": "entity.name.class.sdsl"
						}
					}
				},
				{
					"match": "\\b([A-Za-z_]+\\w*)(::)",
					"captures": {
						"1": {
							"name": "entity.name.section.sdsl"
						},
						"2": {
							"name": "keyword.special.sdsl"
						}
					}
				}
			]
		},
		"literals": {
			"patterns": [
				{
					"name": "entity.name.function.sdsl",
					"match": "\\b([A-Za-z_]+\\w*)\\s*(?:\\()"
				},
				{
					"name": "constant.language.sdsl",
					"match": "\\b(nil|true|false)\\b"
				},
				{
					"name": "constant.name.sdsl",
					"match": "\\b[A-Za-z_]+[\\w]*\\b"
				},
				{
					"name": "constant.numeric.sdsl",
					"match": "\\b-?(0|[1-9])([0-9]*\\.[0-9]*|[0-9]*)"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.comparison.sdsl",
					"match": "(<|>|<=|>=|==|!=)"
				},
				{
					"name": "keyword.assignment.sdsl",
					"match": "(\\*\\*=|\\*=|\\/=|\\/\\/=|%=|\\+=|-=|<<=|>>=|>>>=|&=|\\^=|\\|=|:=|=)"
				},
				{
					"name": "keyword.special.sdsl",
					"match": "(->|,|\\?|\\.\\.|\\.|::|:|;)"
				},
				{
					"name": "keyword.arithmetic.sdsl",
					"match": "(\\*\\*|\\*|\\/|\\/\\/|%|\\+|-|<<|>>|>>>|&|\\^|\\|)"
				},
				{
					"name": "keyword.conditional.sdsl",
					"match": "(&&|\\|\\|)"
				},
				{
					"name": "keyword.unary.sdsl",
					"match": "(-|!)"
				}
			]
		}
	},
	"scopeName": "source.sdsl"
}